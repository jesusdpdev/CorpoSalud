# Local development can use MySQL when DATABASE_URL is blank.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3000

# Production: Supabase PostgreSQL connection string and private Storage settings.
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_SIZE=5
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=excel-imports
CORS_ORIGINS=http://localhost:5173

# Required only when migrating local MySQL into Supabase.
SOURCE_DB_SSL=false

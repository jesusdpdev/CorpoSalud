{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "corposalud-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm ci"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "corposalud-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}